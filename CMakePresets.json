{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
      "cacheVariables": {
        "PROJECT_BUILD_PRESET": "${presetName}"
      }
    },
    {
      "name": "alpha",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gamma",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "beta",
      "inherits": "base",
      "displayName": "Debug with tests and warnings-as-errors",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "PROJECT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Debug with coverage instrumentation (GCC or Clang)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "PROJECT_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "tidy",
      "inherits": "base",
      "displayName": "Debug with clang-tidy",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "PROJECT_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "displayName": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "PROJECT_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Debug with ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "PROJECT_SANITIZERS": "thread"
      }
    },
    {
      "name": "msvc",
      "displayName": "Windows, MSVC cl (run from a Developer Command Prompt)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "PROJECT_BUILD_PRESET": "${presetName}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "alpha",
      "configurePreset": "alpha"
    },
    {
      "name": "gamma",
      "configurePreset": "gamma"
    },
    {
      "name": "beta",
      "configurePreset": "beta"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "coverage-report",
      "configurePreset": "coverage",
      "targets": [
        "coverage"
      ]
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "alpha",
      "configurePreset": "alpha",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gamma",
      "configurePreset": "gamma",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "beta",
      "configurePreset": "beta",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tidy",
      "configurePreset": "tidy",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
