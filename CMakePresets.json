{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
      "cacheVariables": {
        "PROJECT_BUILD_PRESET": "${presetName}"
      }
    },
    {
      "name": "alpha",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gamma",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "beta",
      "inherits": "base",
      "displayName": "Debug with tests and warnings-as-errors",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "PROJECT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "msvc",
      "displayName": "Windows, MSVC cl (run from a Developer Command Prompt)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "PROJECT_BUILD_PRESET": "${presetName}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "alpha",
      "configurePreset": "alpha"
    },
    {
      "name": "gamma",
      "configurePreset": "gamma"
    },
    {
      "name": "beta",
      "configurePreset": "beta"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "alpha",
      "configurePreset": "alpha",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gamma",
      "configurePreset": "gamma",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "beta",
      "configurePreset": "beta",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
